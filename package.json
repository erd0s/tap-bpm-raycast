{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "tap-bpm",
  "title": "Tap BPM",
  "description": "Tap the space bar to find the tempo of a beat",
  "icon": "icon.png",
  "author": "dirk",
  "categories": ["Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "tap-bpm",
      "title": "Tap BPM",
      "description": "Tap Space in time with a beat to measure its tempo",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.7.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.10",
    "eslint": "^10.9.1",
    "prettier": "^3.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "platforms": ["macOS"]
}
